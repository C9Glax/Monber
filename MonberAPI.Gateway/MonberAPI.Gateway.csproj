<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Pure reverse proxy: the UI is served by the frontend resource and proxied
             through, so this project serves no static assets of its own and needs no
             wwwroot. Without this, the Sdk.Web static web assets loader requires
             wwwroot to exist at startup even though nothing uses it. -->
        <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
        <PackageReference Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.6.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\MonberAPI.ServiceDefaults\MonberAPI.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
