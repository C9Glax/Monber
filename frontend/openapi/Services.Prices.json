{
  "openapi": "3.1.1",
  "info": {
    "title": "Services.Prices | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/stores": {
      "get": {
        "tags": [
          "GetStoresEndpoint"
        ],
        "parameters": [
          {
            "name": "brand",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/StoreSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/stores/update": {
      "post": {
        "tags": [
          "PostUpdateStoresEndpoint"
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/prices": {
      "get": {
        "tags": [
          "GetPricesByLocationEndpoint"
        ],
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "float"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "float"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/PriceStreamEvent"
                }
              }
            }
          }
        }
      }
    },
    "/prices/store": {
      "get": {
        "tags": [
          "GetPricesByStoreEndpoint"
        ],
        "parameters": [
          {
            "name": "storeId",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceObservation"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/prices/store/refresh": {
      "post": {
        "tags": [
          "PostRefreshStorePricesEndpoint"
        ],
        "parameters": [
          {
            "name": "storeId",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceObservation"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/prices/history": {
      "get": {
        "tags": [
          "GetPriceHistoryEndpoint"
        ],
        "parameters": [
          {
            "name": "storeId",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PriceObservation"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PriceObservation": {
        "required": [
          "storeId",
          "brand",
          "storeName",
          "product",
          "price",
          "currency",
          "fetchedAt"
        ],
        "type": "object",
        "properties": {
          "storeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The id of the store this price was observed at",
            "format": "int64"
          },
          "brand": {
            "type": "string",
            "description": "The store brand"
          },
          "storeName": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name of the store"
          },
          "product": {
            "type": "string",
            "description": "The tracked product name"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "The observed price",
            "format": "double"
          },
          "currency": {
            "type": "string",
            "description": "The currency of the price"
          },
          "fetchedAt": {
            "type": "string",
            "description": "When this price was observed",
            "format": "date-time"
          },
          "effectiveFrom": {
            "type": [
              "null",
              "string"
            ],
            "description": "If set, this price is not yet active - it becomes effective on this date (e.g. an upcoming sale). Null means the price reflects the store as currently observed.",
            "format": "date"
          },
          "sourceUrl": {
            "type": [
              "null",
              "string"
            ],
            "description": "The page the price was fetched from, if known"
          },
          "validUntil": {
            "type": [
              "null",
              "string"
            ],
            "description": "When this price expires: the start of the day after it was fetched, in the store's local timezone. Prices are only valid on the day they were fetched. Null on raw history rows, where expiry carries no meaning.",
            "format": "date-time"
          }
        }
      },
      "PriceStreamEvent": {
        "required": [
          "storeId",
          "hasPrices",
          "observations"
        ],
        "type": "object",
        "properties": {
          "storeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The id of the store this event reports on",
            "format": "int64"
          },
          "hasPrices": {
            "type": "boolean",
            "description": "Whether any price was found for this store - false if the store was checked but has no tracked prices"
          },
          "observations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceObservation"
            },
            "description": "The prices observed for this store, empty when HasPrices is false"
          }
        }
      },
      "StoreSummary": {
        "required": [
          "storeId",
          "brand",
          "name",
          "latitude",
          "longitude"
        ],
        "type": "object",
        "properties": {
          "storeId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "The id of the store, used as storeId in the /prices endpoints - same id as Services.POI's store id for this location",
            "format": "int64"
          },
          "brand": {
            "type": "string",
            "description": "The store brand"
          },
          "name": {
            "type": [
              "null",
              "string"
            ],
            "description": "The name of the store"
          },
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "The latitude of the store, if known",
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "The longitude of the store, if known",
            "format": "double"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "GetStoresEndpoint"
    },
    {
      "name": "PostUpdateStoresEndpoint"
    },
    {
      "name": "GetPricesByLocationEndpoint"
    },
    {
      "name": "GetPricesByStoreEndpoint"
    },
    {
      "name": "PostRefreshStorePricesEndpoint"
    },
    {
      "name": "GetPriceHistoryEndpoint"
    }
  ]
}